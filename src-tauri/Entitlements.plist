<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow sending Apple Events, which the Mail connector
	     needs (osascript → Apple Mail). Nothing else is needed: WKWebView's JIT
	     runs in Apple's own WebContent process. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
